# API Key del bot de Telegram que manda las solicitudes al grupo de los
# voluntarios. Lo consigue @BotFather.
TELEGRAM_API_KEY=

# Id del grupo de Telegram de destino. Suele empezar por -100.
# Para saberlo: abra el grupo en el navegador, entre en
# https://api.telegram.org/bot<API_KEY>/getUpdates y busque el
# "chat":{"id":...} del grupo.
TELEGRAM_CHAT_ID=
